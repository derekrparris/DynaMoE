# ==========================================
# macOS System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==========================================
# Rust / Cargo
# ==========================================
# Build output directory
/core/target/
target/

# Backup files generated by Cargo
**/*.rs.bk

# Cargo profile data
*.profraw
*.profdata

# ==========================================
# Xcode / Swift
# ==========================================
# User-specific data (open tabs, local window state, breakpoints)
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/

# Xcode build products and Derived Data
DerivedData/
build/
*.xcarchive

# Swift Package Manager (SPM) local builds
.build/
.swiftpm/

# CocoaPods / Carthage (if ever added)
/Pods/
/Carthage/Build/

# ==========================================
# FFI / Generated Bridge Bindings
# ==========================================
# Generated C/Swift header files and compiled dynamic libraries
*.h
*.a
*.dylib
*.so
/DynaMoE/GeneratedFFI/

# EXCEPTION: the hand-written Swift/ObjC bridging header. It is required via
# SWIFT_OBJC_BRIDGING_HEADER and is NOT generated, so ignoring it breaks the
# build on fresh clones and after any `git clean -xfd` / orphan-branch reset.
!DynaMoE/DynaMoE-Bridging-Header.h

# ==========================================
# Local AI Models & Weights (CRITICAL)
# ==========================================
# Never commit model files, checkpoints, or downloaded weights
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
/models/
/weights/
/download_cache/

# ==========================================
# Secrets, Configs & Environment
# ==========================================
.env
.env.local
*.pem
*.key
*.p12
*.cer
/config.local.json
DynaMoE Architectural Overview.md
AGENTS.md

# ==========================================
# Sparkle auto-update tooling
# ==========================================
# Local cache of the Sparkle CLI tools (sign_update), fetched on demand
Tools/sparkle-bin/
# Sparkle private EdDSA key, if ever exported as a file (normally in Keychain)
sparkle_private.key
eddsa_priv.pem
eddsa_pub.pem
