                  <div>
                    <h1>DynaMoE</h1>
                    <div class="meta-line">
                      <span class="ver-chip">v26.9</span>            <!-- EDIT: version -->
                    </div>
                    <div class="tagline">High-Performance MoE Inference Engine for Apple Silicon</div>
