                    align-items: baseline;
                    gap: 8px;
                    margin-top: 2px;
                    font-family: var(--mono);
                  }
                  .ver-chip {
                    font-size: 12.5px;
                    font-weight: 600;
                    color: var(--chip-ink);
                    background: var(--accent-soft);
                    border: 1px solid var(--hairline-soft);
