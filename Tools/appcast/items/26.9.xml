                <style>
                  :root {
                    color-scheme: light dark;
                    --bg: #f2f2f4;
                    --card: #ffffff;
                    --card-2: #f7f7f9;
                    --hairline: rgba(0, 0, 0, 0.08);
                    --hairline-soft: rgba(0, 0, 0, 0.06);
                    --text: #1d1d1f;
                    --text-2: rgba(60, 60, 67, 0.62);
                    --text-3: rgba(60, 60, 67, 0.44);
                    --accent: #af52de;
                    --accent-strong: #8e3cc4;
                    --accent-soft: rgba(175, 82, 222, 0.12);
                    --chip-ink: #8e3cc4;
                    --hero-1: #bf5af2;
                    --hero-2: #5e5ce6;
                    --hero-3: #0a84ff;
                    --glow: rgba(175, 82, 222, 0.35);
                    --mono: "SF Mono", ui-monospace, Menlo, monospace;
                    --sans: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
                    --rounded: "SF Pro Rounded", -apple-system, sans-serif;
                  }
                  @media (prefers-color-scheme: dark) {
                    :root {
                      --bg: #1e1e20;
                      --card: rgba(255, 255, 255, 0.05);
                      --card-2: rgba(255, 255, 255, 0.035);
                      --hairline: rgba(255, 255, 255, 0.09);
                      --hairline-soft: rgba(255, 255, 255, 0.06);
                      --text: #f5f5f7;
                      --text-2: rgba(235, 235, 245, 0.62);
                      --text-3: rgba(235, 235, 245, 0.42);
                      --accent: #bf5af2;
                      --accent-strong: #d9a8f7;
                      --accent-soft: rgba(191, 90, 242, 0.16);
                      --chip-ink: #d9a8f7;
                      --hero-1: #c95bf8;
                      --hero-2: #6b6af0;
                      --hero-3: #2f95ff;
                      --glow: rgba(191, 90, 242, 0.4);
                    }
                  }
                  * { box-sizing: border-box; margin: 0; padding: 0; }
                  ::selection { background: var(--accent-soft); }
                  body {
                    font-family: var(--sans);
                    font-size: 13px;
                    line-height: 1.55;
                    color: var(--text);
                    background: var(--bg);
                    -webkit-font-smoothing: antialiased;
                    padding: 28px 30px 34px;
                    max-width: 640px;
                    margin: 0 auto;
                  }
                  a { color: var(--accent-strong); text-decoration: none; }
                  a:hover { text-decoration: underline; text-underline-offset: 2px; }

                  /* ── Hero header ─────────────────────────────────────────── */
                  header {
                    display: flex;
                    align-items: center;
                    gap: 16px;
                    padding-bottom: 18px;
                    margin-bottom: 22px;
                    border-bottom: 1px solid var(--hairline-soft);
                    position: relative;
