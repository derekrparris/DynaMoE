                    height: 26px;
                    flex: none;
                    border-radius: 7px;
                    background: var(--accent-soft);
                    color: var(--chip-ink);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                  }
                  h2 .icon svg { width: 14px; height: 14px; }

                  /* Feature cards */
                  .card {
                    background: var(--card);
                    border: 1px solid var(--hairline);
                    border-radius: 10px;
                    padding: 13px 15px;
                    margin-bottom: 8px;
                  }
                  .card h3 { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
                  .card p { color: var(--text-2); font-size: 12.5px; }
                  .card code, p code, li code {
                    font-family: var(--mono);
                    font-size: 11px;
                    background: var(--accent-soft);
                    color: var(--chip-ink);
                    border-radius: 4px;
                    padding: 1px 5px;
                  }

                  /* Fixed / changed lists */
                  ul.changes { list-style: none; }
                  ul.changes li {
                    position: relative;
                    padding-left: 22px;
                    margin-bottom: 6px;
                    color: var(--text-2);
                  }
                  ul.changes li::before {
                    content: "";
                    position: absolute;
                    left: 4px;
                    top: 6px;
                    width: 5px;
                    height: 5px;
                    border-radius: 50%;
                    background: var(--accent);
                    opacity: 0.75;
                  }
                  ul.changes li strong { color: var(--text); font-weight: 600; }

                  /* Spec rows (About-window style) */
                  .spec {
                    background: var(--card-2);
                    border: 1px solid var(--hairline-soft);
                    border-radius: 10px;
                    padding: 3px 15px;
                  }
                  .spec .row {
                    display: flex;
                    align-items: baseline;
                    justify-content: space-between;
                    gap: 16px;
                    padding: 9px 0;
                  }
                  .spec .row + .row { border-top: 1px solid var(--hairline-soft); }
                  .spec .row .k { color: var(--text-2); font-size: 12px; }
                  .spec .row .v {
                    font-family: var(--mono);
                    font-size: 11.5px;
                    font-weight: 600;
                    text-align: right;
                  }

                  /* Footer action buttons */
                  footer {
                    display: flex;
                    gap: 9px;
                    flex-wrap: wrap;
                    margin-top: 4px;
                  }
                  footer a.btn {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    font-size: 11.5px;
                    font-weight: 500;
                    color: var(--text);
                    background: var(--card);
                    border: 1px solid var(--hairline);
                    border-radius: 6px;
                    padding: 6px 12px;
                  }
                  footer a.btn:hover { background: var(--accent-soft); text-decoration: none; }
                  footer a.btn svg { width: 12px; height: 12px; opacity: 0.55; }
                  .fineprint {
                    margin-top: 16px;
                    font-size: 10.5px;
                    color: var(--text-3);
                  }
